# Copy to .env and fill in. Never commit the real .env, and never share these values.
# On a server (Render, ...) set the same names in its Environment settings instead of using a file.

NODE_ENV=development
PORT=4100

# ---- Database: MySQL 8 ----
# The API connects with a least-privilege login (read/write data only, no changing tables).
# Create both logins with db/setup-mysql.sql (or in your cloud provider's panel).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=atiyaherbs
DB_USER=atiya_app
DB_PASSWORD=
# true = encrypted connection with a checked certificate. Needed by cloud MySQL (Aiven, TiDB Cloud, ...).
# Production refuses DB_SSL=false when DB_HOST is another machine.
DB_SSL=false

# Separate login used ONLY by migrations (npm run db:migrate:*). It may create and change tables.
MIGRATE_DB_USER=atiya_migrator
MIGRATE_DB_PASSWORD=

# ---- Secrets (each at least 32 random characters) ----
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
OTP_PEPPER=

# Shared secret that call-backend sends (header X-Internal-Key) when it saves call history and meeting chat here.
# Leave empty to switch those routes off (they then do not exist). Same value goes into call-backend's settings.
INTERNAL_API_KEY=

# ---- Login settings (defaults shown) ----
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_SECONDS=600

# ---- OTP delivery ----
# dev  = the OTP is printed in the server log (no SMS, free). Refused in production.
# sms  = real SMS provider (not written yet: production cannot send OTPs until it is)
OTP_SENDER=dev
# Development only: also return the OTP in the API response so you can test without reading the log
OTP_DEV_ECHO=false

# ---- Network ----
# Proxies in front of the server (Render = 1, direct = 0)
TRUST_PROXY=1
# Websites allowed to call the API from a browser, comma separated. The mobile app needs none.
CORS_ORIGINS=
# Doctor photo uploads for the admin panel (Cloudinary). Leave empty until photo upload is set up.
# Consultation videos (the doctor uploads them). The folder is private to the server; keep it backed up.
VIDEO_STORAGE_DIR=./storage/videos
VIDEO_MAX_MB=500
VIDEO_MAX_PER_APPOINTMENT=3
VIDEO_RETENTION_DAYS=365
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
