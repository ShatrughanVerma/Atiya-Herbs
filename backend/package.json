{
  "name": "atiyaherbs-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Atiya Herbs API: OTP login, shop, orders, addresses, call and meeting history (Express, Prisma, MySQL)",
  "license": "UNLICENSED",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "jest",
    "pretest": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:deploy-fresh": "node prisma/deployFresh.js",
    "videos:export": "node prisma/exportVideo.js",
    "db:seed": "node prisma/seed.js",
    "db:set-password": "node prisma/setPassword.js",
    "db:create-admin": "node prisma/createAdmin.js",
    "videos:archive": "node prisma/archiveVideos.js",
    "db:grant-credits": "node prisma/grantCredits.js",
    "db:seed-consultation": "node prisma/seedConsultation.js",
    "db:import-shopify": "node prisma/importShopify.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
