# Copy to .env and fill in from LiveKit Cloud (cloud.livekit.io) -> your project -> Settings -> Keys.
# Never commit the real .env, and never put the API secret in the mobile app.

PORT=4000

# Your project's WebSocket URL, e.g. wss://atiyaherbs-abc123.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# How long an unanswered call rings, and how long a call survives a dropped connection
RING_TIMEOUT_MS=45000
RECONNECT_GRACE_MS=15000
