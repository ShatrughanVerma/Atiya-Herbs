# Copy to .env and fill in from LiveKit Cloud (cloud.livekit.io) -> your project -> Settings -> Keys.
# Never commit the real .env, and never put the API secret in the mobile app.

PORT=4000

# Your project's WebSocket URL, e.g. wss://atiyaherbs-abc123.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Agora as a second calling provider (optional) ----
# Which provider new calls use: livekit (default), agora, or auto (LiveKit while it answers, Agora while it does not;
# checked every minute). If agora/auto is chosen but the two values below are empty, calls keep using LiveKit.
# A call stays on the provider it started with, except that a phone which cannot connect through LiveKit asks for
# the call to be moved to Agora. Agora calls cannot be recorded yet.
# Agora console (console.agora.io) -> your project -> App ID, and turn on the Primary Certificate. Backend only.
CALL_PROVIDER=livekit
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# How long an Agora token lasts (it must cover the whole call)
AGORA_TOKEN_HOURS=4

# ---- Call links that open in a browser, no app needed (uses Agora, needs the two Agora values above) ----
# Making a link needs this secret in the x-invite-key header: POST /agora/invites. Use a long random text.
INVITE_KEY=
# Optional: the address put in the links (otherwise the address the request came to). Minutes a link works, and how
# many times each link can be opened (a refresh or a dropped connection counts as another time)
PUBLIC_URL=
INVITE_MINUTES=60
INVITE_MAX_JOINS=4
# A group link (POST /agora/invites with {"people": 6}) can allow up to this many people
INVITE_MAX_PEOPLE=50

# ---- Group meetings on Agora (needs the two Agora values above; see docs/MEETINGS.md) ----
# Most people in one meeting (the host can ask for fewer), at most 100
MEETING_MAX_PARTICIPANTS=25
# How long a dropped connection keeps its place in a meeting before the person is taken out
MEETING_RECONNECT_GRACE_MS=20000
# How many meetings one person can start in an hour
MEETING_CREATE_PER_HOUR=10
# How long an ended meeting is remembered, so late joiners hear "ended" and not "not found"
MEETING_KEEP_ENDED_MS=3600000

# How long an unanswered call rings, and how long a call survives a dropped connection
RING_TIMEOUT_MS=45000
RECONNECT_GRACE_MS=15000

# ---- Call recording (optional). Recordings are saved to Cloudflare R2; their details to Cloudflare D1.
# Recording is offered in the app only when all four R2 values are filled in.
# R2: Cloudflare dashboard -> R2 Object Storage -> your bucket, and Manage R2 API tokens.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Empty for Cloudflare R2. For Backblaze B2 (any S3-style bucket) put its region, e.g. us-west-004
R2_REGION=

# D1 (a free SQLite database on Cloudflare) holds who/when/how long/which file/who agreed.
# Leave empty to keep these details in memory only (lost when the server restarts).
CF_ACCOUNT_ID=
D1_DATABASE_ID=
CF_API_TOKEN=

# audio (small, recommended) or video
RECORDING_MODE=audio
# Video only: record in short chunks that are uploaded during the call, then joined into one file when it ends.
# Set RECORDING_CHUNKS=false for one single file instead. Chunk length in seconds (2-30):
RECORDING_CHUNKS=true
RECORDING_SEGMENT_SECONDS=5
# Video size (the defaults come to about 80 MB an hour): width, height, frames per second, video and audio kbit/s
RECORDING_VIDEO_WIDTH=640
RECORDING_VIDEO_HEIGHT=360
RECORDING_VIDEO_FPS=15
RECORDING_VIDEO_KBPS=150
RECORDING_AUDIO_KBPS=32
# Stop offering recording a little before LiveKit's free ~60 recording minutes a month run out
RECORDING_MONTHLY_MINUTES=50

# ---- Store the recordings in Cloudinary (optional) ----
# LiveKit can only write to an S3-style bucket, so R2 (above) is used as a short staging area: the backend
# copies each finished recording to Cloudinary and then deletes it from R2. If the copy fails, the file
# simply stays in R2. Leave these empty to keep recordings in R2.
# Cloudinary dashboard -> Settings -> API Keys. The API secret is backend-only; never put it in the app.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# authenticated = needs a signed link to open (recommended for health recordings); upload = public link
CLOUDINARY_DELIVERY_TYPE=authenticated
CLOUDINARY_FOLDER=atiyaherbs/call-recordings
# Cloudinary's free plan allows videos up to 100 MB per file; bigger ones stay in R2
CLOUDINARY_MAX_MB=100
# Set to true to keep the R2 copy as well (uses more R2 space)
RECORDING_KEEP_R2_COPY=false

# ---- Compress each recording before it is stored (needs ffmpeg; the Docker image has it) ----
# Runs automatically once the call has ended. Audio becomes mono Opus (about 11 MB an hour at 24k).
# If ffmpeg is missing or fails, the original recording is stored instead, so nothing is lost.
RECORDING_COMPRESS=true
RECORDING_AUDIO_BITRATE=24k
# Install ffmpeg on your PC to compress when running locally, or point to it:
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
