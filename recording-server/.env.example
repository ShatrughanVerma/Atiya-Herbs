# Copy to .env. Never commit the real .env.

PORT=5000
# Listen on this address. Keep 127.0.0.1 when IIS/Caddy in front handles HTTPS, or 0.0.0.0 with TLS_KEY/TLS_CERT below
HOST=127.0.0.1
# Optional: serve HTTPS directly from Node (paths to the PEM files). Leave empty when a reverse proxy does TLS.
TLS_KEY=
TLS_CERT=

# Secrets (use long random text, 32+ characters)
# INGEST_KEY: sent by the LiveKit side when it uploads chunks and says a call has finished
# READ_KEY: used by the Node.js backend to read status and stream a finished recording
INGEST_KEY=
READ_KEY=

# Folders on the recording server's own disk (use a separate drive from Windows, e.g. D:)
CHUNK_DIR=D:\recordings\chunks
RECORDING_DIR=D:\recordings\final
LOG_DIR=D:\recordings\logs

# MySQL (the server creates the database "recordings" and its tables itself if the user is allowed to;
# otherwise create an empty database with that name first)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=recordings
MYSQL_USER=
MYSQL_PASSWORD=

# ---- Pull chunks from the staging bucket (when the call backend is on Render and cannot reach this PC) ----
# LiveKit writes the chunks to this bucket (Backblaze B2: endpoint like https://s3.us-east-005.backblazeb2.com).
# This server downloads them to its own disk, queues the call when LiveKit has ended the recording, and clears the bucket.
# Leave PULL_BUCKET empty to turn this off. The key needs list, read and delete rights on the bucket.
PULL_ENDPOINT=
PULL_REGION=
PULL_BUCKET=
PULL_ACCESS_KEY_ID=
PULL_SECRET_ACCESS_KEY=
PULL_PREFIX=recordings/
PULL_POLL_SECONDS=10
PULL_DELETE_AFTER=true

# FFmpeg (full path on Windows if it is not on PATH)
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# Video size/quality of the final MP4
RECORDING_VIDEO_CRF=28
RECORDING_AUDIO_KBPS=64
# Video is made no wider than this and no faster than this many frames a second (smaller file; never enlarged)
RECORDING_VIDEO_MAX_WIDTH=640
RECORDING_VIDEO_MAX_FPS=15

# Biggest single chunk accepted, in MB
MAX_CHUNK_MB=50
# A call with no new chunk for this many seconds and no "finish" message is closed by itself
IDLE_FINISH_SECONDS=120
# Processing retries and the wait before the first retry (it doubles each time)
MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=30
# Delete the chunks once the final MP4 is checked (true) or keep them (false)
DELETE_CHUNKS_AFTER=true
# With DELETE_CHUNKS_AFTER=false the chunks are kept this many days after the MP4 was made, then removed (MP4 stays). 0 = keep forever
CHUNK_RETENTION_DAYS=2
# How often the worker looks for a call to process
WORKER_POLL_MS=3000
# Warn in the log when the recordings drive has less free space than this (GB)
MIN_FREE_GB=20
