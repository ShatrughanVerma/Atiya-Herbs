{
  "name": "atiyaherbs-recording-server",
  "version": "0.1.0",
  "private": true,
  "description": "Receives call recording chunks over HTTPS, keeps them on local disk, joins them with FFmpeg into one MP4 (Express, MSSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  }
}
